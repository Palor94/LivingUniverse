# Default deny: this directory already contains private media.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/PROJECT_VISION.md
!/DECISIONS.md
!/DEVELOPMENT_PLAN.md
!/docs/
/docs/*
!/docs/VISUAL_IDENTITY.md
!/docs/ASSISTED_SORTING.md
!/package.json
!/Start Living Universe.cmd
!/app/
!/tests/
/app/**/node_modules/
/app/**/__pycache__/

# Secrets, dependencies, Python caches, and local databases.
.env
.env.*
!.env.example
node_modules/
.venv/
__pycache__/
*.db
*.sqlite
*.sqlite3
# SQLite runtime sidecars can also contain private data.
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
